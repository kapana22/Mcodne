node_modules
.next
.next-check
out
.env
.env.local
*.log
.DS_Store
tsconfig.tsbuildinfo
.planflow

# Agent scratch — one-off seeds, snapshots and backups. Excluded from tsconfig
# too (a stray .tsx here once broke the Railway build while the gate stayed green).
scratch/

# Throwaway one-off DB probes (scripts/_qa*.ts). They are written against
# whatever the schema looked like that afternoon, so a stale one breaks the
# gate’s type stage for a file nothing imports.
scripts/_qa*.ts

# Build output written by a stray distDir override — never commit it.
private/

# Playwright's own output — a trace zip is ~5 MB and a failed run leaves several.
# `railway up` uploads the WORKING TREE, so anything here would ship with the
# site if it were not ignored.
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
