{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "/private/tmp/claude-501/-Users-kapana-Desktop-------/e1dea262-0fa4-4ff3-8da2-290455efcc40/scratchpad/next-dev/types/**/*.ts",
    "/private/tmp/claude-501/mcodne-build/types/**/*.ts",
    "next-env.d.ts",
    "/private/tmp/claude-501/-Users-kapana-Desktop-------/e1dea262-0fa4-4ff3-8da2-290455efcc40/scratchpad/next-build/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "scratch"
  ]
}
