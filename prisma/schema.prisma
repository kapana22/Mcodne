// Prisma schema for მცოდნე platform
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Two roles and an admin. USER buys, PROVIDER sells, and a consultation is a
/// KIND of service — so whoever sells one is a PROVIDER too, which is why there
/// is no „consultant" here (2026-08-21).
///
/// STUDENT and TUTOR are the words the column used to hold and are kept ONLY
/// until the backfill has run — lib/roles → `asRole` maps them on read so the
/// deploy and the data move stay independent. Delete them once
/// `SELECT DISTINCT role FROM "User"` shows three values.
// ⚠️ TWO VALUES LEFT ON 2026-08-24: `STUDENT` and `TUTOR`. They were the
// original pair — a learner and a teacher — renamed to USER/PROVIDER when the
// site stopped being a tutoring platform, and kept afterwards only because a
// Postgres enum cannot drop a value in place. Measured before the drop: 29
// PROVIDER, 30 USER, 4 ADMIN, and NOBODY on either legacy value. The migration
// swaps the type; the guard refuses if a single row still carries one.
//
// What this ends is the confusion CLAUDE.md spent a section on — „2 selling
// services carry role STUDENT" — which stopped being true when the roles were
// renamed and stayed in the file as a warning about a table nobody could fix.
enum Role {
  USER
  PROVIDER
  ADMIN
}

enum ApplicationStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  NEEDS_REVISION
}

// How a sphere behaves in public. Replaces the old `isLive` boolean, which
// could only say „in the menu" or „gone" — and „gone" meant the page 404'd,
// taking its indexed URL with it.
//
//   VISIBLE     in the menu, on the home grid, in the browse filter
//   HIDDEN      the page still works and still ranks; it is only out of the
//               menus. For a sphere with no experts yet, that is the honest
//               state: keep the landing page, stop advertising an empty room
//   REDIRECTED  it became a sub-topic of `parent`. The row is KEPT, its experts
//               keep pointing at it, and the old URL 301s — see
//               lib/categoryTree for where it 301s TO.
enum CategoryStatus {
  VISIBLE
  HIDDEN
  REDIRECTED
}

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  passwordHash      String
  fullName          String
  phone             String?
  avatarUrl         String?
  bio               String?
  role              Role      @default(USER)
  locale            String    @default("ka")
  emailVerified     Boolean   @default(false)
  // Per-type opt-outs for in-app Notification writes. Keyed by NotifType string
  // (BOOKING_CREATED, MESSAGE_NEW, REVIEW_NEW, APPLICATION_STATUS,
  // ADMIN_BROADCAST). `null` → all types enabled (default). Missing keys inside
  // the JSON default to enabled — only explicit `false` disables.
  notificationPrefs Json?
  // Admin safety switch: non-null → account is suspended (signin blocked).
  // Set/cleared via PATCH /api/admin/users/[id]; reason lives in the audit log.
  suspendedAt       DateTime?
  // ⚠️ THE ONLY THING BEHIND „ონლაინ ვართ" (2026-08-17). Stamped every ~40s by
  // an admin with the panel open, and read by nobody else: the client's thread
  // asks „is anybody at the desk" and gets an answer computed from THIS, not
  // from a working-hours table. A schedule would say „online" at 11:00 on a day
  // the operator is ill, and a badge that lies is worse than no badge — the
  // whole reason to show one is that the person deciding whether to wait can
  // trust it. One nullable column rather than a presence table: there is one
  // fact per account and it has no history worth keeping.
  supportSeenAt     DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // B2B (2026-08-11). A VIRTUAL field — Prisma back-relations emit no SQL, so
  // this line adds nothing to the User table. The whole vertical is dark behind
  // B2B_VISIBILITY (lib/flags.ts); an account with no membership row is
  // indistinguishable from one on a deployment where B2B does not exist.
  companyMemberships  CompanyMember[]
  reviewsGiven        Review[]             @relation("ReviewsGiven")
  favorites           Favorite[]
  creditEntries       CreditEntry[]
  notifications       Notification[]
  sessions            Session[]
  otpCodes            OtpCode[]
  resetTokens         PasswordResetToken[]
  // Requests (2026-08-14). All three are VIRTUAL — Prisma back-relations emit
  // no SQL, so these lines add nothing to the User table. The subsystem is dark
  // behind FEATURE_REQUESTS (lib/requests.ts); an account with no
  // `requestAccess` row is indistinguishable from one on a deployment where the
  // feature does not exist.
  serviceRequests     ServiceRequest[]
  requestOffers       RequestOffer[]
  requestMessages     RequestMessage[]
  requestAccess       RequestAccess?
  serviceProfile      ServiceProfile?
  providerApplication ProviderApplication?

  // Admin filters + list order-by
  @@index([role])
  @@index([createdAt])
  // Expert search matches on the expert's name too — see the TutorProfile
  // trigram block. Also created in lib/dbBoot under this same name.
  @@index([fullName(ops: raw("gin_trgm_ops"))], type: Gin, map: "User_fullName_trgm_idx")
}

model OtpCode {
  id        String   @id @default(cuid())
  userId    String
  code      String
  purpose   String // "verify" | "reset"
  expiresAt DateTime
  consumed  Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  consumed  Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // reset-request deleteMany filters by userId — otherwise full scan
  @@index([userId])
}

model Session {
  id             String   @id @default(cuid())
  userId         String
  token          String   @unique
  expiresAt      DateTime
  // When this session was created via admin impersonation, holds the original
  // admin's userId. `null` for normal sessions. The impersonation "exit" flow
  // restores THIS admin — bound server-side so a client-forged cookie can no
  // longer mint an admin session.
  impersonatorId String?
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // revokeOtherSessions + password-reset session wipes filter by userId
  @@index([userId])
  // Cleanup jobs use expiresAt; scanning expired sessions must be fast
  @@index([expiresAt])
}

model Category {
  id     String         @id @default(cuid())
  slug   String         @unique
  name   String
  icon   String?
  count  Int            @default(0)
  order  Int            @default(0)
  // DEPRECATED — superseded by `status`, kept for one release so the migration
  // is reversible without data loss. Dropped in the follow-up migration once
  // every reader is on `status`.
  isLive Boolean        @default(true)
  status CategoryStatus @default(VISIBLE)

  // Sub-topic hierarchy. A REDIRECTED sphere points at the one that absorbed
  // it; experts keep their own categoryId, so nothing is re-pointed and no
  // booking history moves — the parent simply counts its children's experts
  // as well. Self-referential, nullable, and never cascading: deleting a
  // parent must fail loudly rather than orphan a subtree.
  parentId String?
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children Category[] @relation("CategoryTree")

  providers       ServiceProfile[]
  // Requests filed under this sphere (2026-08-14). Virtual back-relation, no
  // SQL. The FK on ServiceRequest is Restrict, so deleting a sphere that still
  // carries requests fails loudly instead of silently unfiling them.
  serviceRequests ServiceRequest[]

  // Searching a sphere by its visible label („მარკეტინგში") must find that
  // sphere's experts — see the TutorProfile trigram block. Also in lib/dbBoot.
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "Category_name_trgm_idx")
}

// Blog post — DB-backed so content is edited in the admin panel, not in code.
// `status` is a plain string ('DRAFT' | 'PUBLISHED'); only PUBLISHED posts (with
// a publishedAt) show on the public /blog. `body` is Markdown, rendered via
// lib/markdown. Created via dbBoot inline DDL (see lib/dbBoot).
model Post {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  excerpt     String?
  body        String    @default("")
  coverUrl    String?
  tag         String?
  status      String    @default("DRAFT")
  authorName  String?
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, publishedAt])
}

// Editable site copy — a key → value override store. The full list of editable
// keys (with labels, defaults, grouping) lives in code at lib/siteTextDefs; a
// row here overrides the code default. Missing row → the default is used, so
// the site works with an empty table. Created via dbBoot inline DDL.
/// THE PROVIDER'S BALANCE, AS A LEDGER (2026-08-20).
///
/// ⚠️ EVERY MOVEMENT IS A ROW; THE BALANCE IS THEIR SUM. There is deliberately
/// no mutable counter to „fix" — „რატომ მაქვს 40₾?" must be answerable by
/// reading rows, and a number that can be edited without a reason is a number
/// nobody trusts. Owner: „ეს რეალურად 100₾ ტოლფასი მივცეთ… და არა რაღაც
/// უაზრო ტოკენები."
///
/// ⚠️ TETRI, NEVER LARI, AND NEVER A FLOAT. `amountTetri` is a signed integer:
/// positive is granted, negative is spent. Money in a float is how a balance
/// ends up at 39.999999.
///
/// ⚠️ IT IS NOT CASH AND THE COPY MAY NEVER SAY IT IS. The balance buys ONE
/// thing — sending an offer. It cannot be withdrawn, transferred or refunded,
/// which is exactly why it is safe to denominate in lari at a stage where
/// `PAYMENTS_LIVE` is false: nothing here is a payment, a purchase or a
/// liability. See lib/credits.ts for the wording that must hold.
model CreditEntry {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Signed. Grants are positive, spends negative.
  amountTetri Int
  /// Why this row exists — a `CreditReason` from lib/credits, stored as text so
  /// adding one is an edit to an array and never a migration (the same choice
  /// the budget bands and the request timings already made).
  reason      String

  /// ⚠️ THE IDEMPOTENCY KEY FOR A ONE-OFF GRANT, and NULL for everything else.
  /// „a photo is worth 15₾" must pay once however many times the profile is
  /// saved, so a grant carries a key and the unique index refuses the second
  /// row. Postgres treats NULLs as distinct in a unique index, so spends — which
  /// repeat by nature — are unconstrained by the same index. That is the whole
  /// mechanism; do not add a second table for it.
  grantKey String?
  /// What was bought, when something was: the RequestOffer id.
  refId    String?

  createdAt DateTime @default(now())

  @@unique([userId, grantKey])
  @@index([userId, createdAt])
}

model SiteText {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model Review {
  id String @id @default(cuid())

  /// THE FINISHED JOB THIS RATES.
  ///
  /// ⚠️ IT WAS `bookingId` UNTIL 2026-08-24, and the column is gone with the
  /// booking. A review is now written against a RequestOffer the client marked
  /// done — the one path on the site where money and work actually changed
  /// hands. Nullable + unique for the same reason it always was: unique makes
  /// „once" the DATABASE's answer rather than a check, and NULLs do not fight
  /// under a unique index in Postgres.
  offerId String? @unique

  /// Who wrote it. The relation name is historical („ReviewsGiven") and stays —
  /// renaming it would rewrite every include for nothing.
  studentId String

  rating Int
  body   String

  ratingKnowledge   Int?
  ratingClarity     Int?
  ratingValue       Int?
  ratingPunctuality Int?

  /// The provider's answer, and when they gave it.
  tutorResponse String?
  respondedAt   DateTime?

  anonymous Boolean  @default(false)
  createdAt DateTime @default(now())

  offer   RequestOffer? @relation(fields: [offerId], references: [id])
  student User          @relation("ReviewsGiven", fields: [studentId], references: [id])

  @@index([studentId])
  @@index([createdAt])
}

model Favorite {
  id         String   @id @default(cuid())
  userId     String
  /// ⚠️ WAS `tutorId` → TutorProfile UNTIL 2026-08-24. Same column, renamed and
  /// repointed at the one provider profile; the saved row survived the move
  /// because the new profile carries the OLD id (see the migration).
  providerId String
  createdAt  DateTime @default(now())

  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider ServiceProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([userId, providerId])
  // The composite unique is (userId, providerId)-prefixed, so a providerId-only
  // lookup (cascade-delete favourites when a profile is removed) can't use it.
  @@index([providerId])
  @@index([userId, createdAt])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  title     String
  body      String?
  href      String?
  // Semantic type: BOOKING_CREATED, BOOKING_CANCELED, MESSAGE_NEW, REVIEW_NEW, APPLICATION_STATUS, PAYOUT
  type      String    @default("GENERIC")
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([userId, createdAt])
  // Created by lib/dbBoot.ts — declared here so `prisma db push` won't drop it.
  // Serves the cleanup cron's BOOKING_REMINDER dedupe (type=… AND href IN …).
  @@index([type, href])
}

// Append-only audit trail of admin actions. Every mutating admin action
// (impersonate/exit, application approve/reject, booking cancel-as-admin,
// review delete, category toggle, broadcast send) writes one row here.
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String // admin user id (or null for system)
  action     String // e.g. 'application.approve', 'booking.cancel', 'review.delete'
  targetType String? // e.g. 'Booking', 'Review', 'User', 'TutorApplication'
  targetId   String? // FK to the target; not enforced (targets may be soft-deleted later)
  meta       Json? // action-specific detail (reason, previous status, etc.)
  createdAt  DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@index([createdAt])
}

// ═══════════════════════════════════════════════════════════════════════════
// B2B — companies with a prepaid balance.  2026-08-11
//
// The whole vertical is dark behind `B2B_VISIBILITY` in lib/flags.ts. These
// four tables exist on every deployment (lib/dbBoot creates them at boot) and
// are EMPTY until an admin fills them, which is the same contract every other
// vertical here ships on: the schema knows about the feature, the site does not.
//
// WHAT THIS IS NOT, so nobody builds it by accident: there is no gateway, no
// invoice, no escrow, no subscription and no automatic charge. A balance is a
// number an admin types in after money arrived by some other route, and a
// charge is that number going down when a member books. `PAYMENTS_LIVE` stays
// false and is untouched by any of this.
//
// MONEY IS `Int` LARI, matching Booking.price, Enrollment.priceTotal and
// TutorProfile.price. There is no tetri anywhere in this database and this is
// not the feature that should introduce one.
// ═══════════════════════════════════════════════════════════════════════════

enum CompanyStatus {
  ACTIVE
  // Balance frozen: the company still exists and its ledger is still readable,
  // but no member may spend. Mirrors User.suspendedAt — a safety switch, not a
  // delete. Nothing is ever deleted here; a ledger you can erase is not a ledger.
  SUSPENDED
}

enum CompanyMemberRole {
  // May be listed as the billing contact. Carries NO extra power today — it is
  // recorded because an admin needs to know who to call, and inventing the
  // distinction later means backfilling it from memory.
  OWNER
  MEMBER
}

enum CompanyTransactionType {
  // An admin put money on the balance (ჩარიცხვა). Also covers a correction
  // upward — the note says which, and the audit log says who.
  TOPUP
  // A booking spent it (ჩამოჭრა), or an admin corrected downward.
  CHARGE
}

// Where a booking's money came from. Read `Booking.paidBy` through
// `paymentSourceOf()` in lib/b2b.ts, never directly — `null` is the historical
// value and means CARD.
enum PaymentSource {
  CARD
  COMPANY_BALANCE
}

enum BusinessLeadStatus {
  NEW
  CONTACTED
  CLOSED
}

model Company {
  id      String        @id @default(cuid())
  name    String
  // საიდენტიფიკაციო კოდი. Nullable because an admin may create the row from a
  // phone call before the paperwork arrives; UNIQUE because two companies
  // sharing one identification code means one of them is a typo, and Postgres
  // allows any number of NULLs under a unique constraint so the nullable and
  // the unique do not fight.
  taxId   String?       @unique
  // Lari. NEVER decrement this with a read-then-write: claim it conditionally
  // (`where: { id, balance: { gte: amount } }` + `count !== 1 → 409`), the rule
  // in CLAUDE.md and the pattern in app/api/bookings/[id]/cancel. A second tab
  // beats a check-then-set every time, and here that overdraws a real balance.
  balance Int           @default(0)
  status  CompanyStatus @default(ACTIVE)
  // Admin's own scratch note (contract number, who to call). Never shown to a
  // member — only the admin panel reads it.
  note    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members        CompanyMember[]
  transactions   CompanyTransaction[]
  serviceProfile ServiceProfile?
  // Requests (2026-08-14) — virtual back-relations, no SQL. A company bids on a
  // request as one counterparty; the members do not each get their own offer.
  requestOffers  RequestOffer[]
  requestAccess  RequestAccess?

  // The admin list: active companies first, newest first.
  @@index([status, createdAt])
}

model CompanyMember {
  id        String            @id @default(cuid())
  companyId String
  userId    String
  role      CompanyMemberRole @default(MEMBER)
  createdAt DateTime          @default(now())

  // Cascade on BOTH sides, and deliberately unlike Booking's Restrict.
  //
  // Booking uses Restrict so deleting an account with session history FAILS —
  // it protects the counterparty's records. A membership is not a record of
  // anything that happened: it is a permission. When the account goes, the
  // permission must go with it, and it must never be the reason an account
  // cannot be deleted (app/api/admin/users/[id] DELETE would start refusing
  // accounts for a reason the operator cannot see). The MONEY is not here — it
  // is in CompanyTransaction, which has no FK to anything and survives both.
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  // One membership per person per company. Also the index that answers the
  // booking flow's only question — „is this user in this company?"
  @@unique([companyId, userId])
  // „which company is this user in?", asked once per booking-flow open.
  @@index([userId])
}

model CompanyTransaction {
  id           String                 @id @default(cuid())
  companyId    String
  type         CompanyTransactionType
  // ALWAYS POSITIVE. The direction lives in `type`, so no reader has to
  // remember a sign convention, and `SUM(amount)` can never silently mean two
  // different things depending on which rows it caught.
  amount       Int
  // The balance this row left behind. Redundant with a replay of the ledger and
  // kept anyway: it is how you find the row where the arithmetic went wrong.
  balanceAfter Int

  // The booking that spent it, when a booking spent it. A PLAIN STRING, with an
  // index and NO foreign key — on purpose. A ledger row must outlive its
  // subject: if a Booking is ever deleted, a FK would either take the money row
  // with it (CASCADE) or block the delete (RESTRICT), and both are wrong for an
  // accounting record. Same reasoning as AuditLog.targetId.
  bookingId String?
  // The admin who did it. Null for a charge the booking flow made by itself.
  // Plain string for the same reason as bookingId; the full story is in AuditLog.
  actorId   String?
  note      String?

  createdAt DateTime @default(now())

  // Cascade from Company only. Deleting a company is not a thing the admin
  // panel offers — but if it is ever done by hand, an orphaned ledger pointing
  // at a company that does not exist is worse than no ledger.
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // The ledger view: one company, newest first.
  @@index([companyId, createdAt])
  // „was this booking charged to a balance, and which row did it?"
  @@index([bookingId])
}

// A service we sell to companies, at a fixed price.  2026-08-11
//
// THE PRODUCT IS THE SERVICE, NOT THE EXPERT — and that is the whole difference
// from the rest of this platform. On /tutors a client picks a person and books
// their hour; here a company buys „იურიდიული აუდიტი — 800₾" and WE decide who
// delivers it. That choice happens off the platform entirely: the owner agrees
// it by phone or mail and assigns somebody they already know. There is
// deliberately NO expert field on this model and no assignment flow — modelling
// a decision that is made in a conversation would only produce a column nobody
// keeps up to date.
//
// No booking, no calendar, no escrow. A request arrives, the owner agrees a
// price, and the invoice happens outside this system.
model B2BService {
  id             String  @id @default(cuid())
  // WHAT KIND of service it is — 'CONSULTATION' or 'TRAINING'.
  //
  // WHY THIS EXISTS (2026-08-12, owner): the offer is „a consultation or a
  // training, in business or sales or something else" — two independent
  // questions. There was only `direction`, so the two got mixed INTO one field:
  // production held „HR", „იურიდიული", „ფინანსური" (areas) alongside
  // „ტრენინგები" (a kind). The model therefore could not express „a training in
  // sales" at all — a sales training had to be filed either under its kind or
  // under its area, never both, and the page grouped them as if they were the
  // same axis.
  //
  // A String and not a Postgres enum, deliberately: the set is read through
  // lib/b2b (B2B_KINDS) and validated by zod at both ends, and a two-value enum
  // type is not worth a migration that has to run before any column using it.
  kind           String  @default("CONSULTATION")
  // The AREA it belongs to — „იურიდიული", „ფინანსური", „გაყიდვები".
  // Free text and NOT a Category FK on purpose: the sphere taxonomy describes
  // what EXPERTS do and is admin-edited for the public catalogue. Borrowing it
  // here would tie a B2B price list to a rename made for a different reason.
  direction      String
  title          String
  description    String?
  // One short meta line under the title: „4 საათი · ჯგუფური · ონლაინ",
  // „ერთჯერადი", „თვეში 2 შეხვედრა". Optional and free text.
  //
  // WHY A SEPARATE FIELD AND NOT PART OF description. A TRAINING is a service
  // like any other here, but it is the one where format decides whether it fits
  // at all — how many people, how long, where. Buried in a sentence a company
  // has to read for it; on its own line they can scan a whole direction and
  // rule things in or out. Everything else may simply leave it empty.
  format         String?
  // The card image, as a `data:image/webp;base64,…` produced by /api/uploads
  // (kind=cover → hard-cropped to 1200x675). There is no object storage, so it
  // lives in the column like every other image here.
  //
  // ⚠️ NEVER SELECT THIS INTO A PAGE PAYLOAD. Six cards of inline base64 is
  // most of a megabyte re-sent on every navigation and cacheable by nothing —
  // the exact shape /api/avatars/[id] was built to undo. /business selects a
  // `hasImage` boolean and points <img> at /api/b2b-services/[id]/image, which
  // the browser then caches per service.
  imageUrl       String?
  // Lari, like every other price in this database. This is the number a company
  // reads on the page — the one actually invoiced may differ after a
  // conversation, which is what BusinessLead.agreedPrice records.
  priceGel       Int
  // „ფასი შეთანხმებით" — shown instead of the number when true, for work that
  // cannot honestly carry a fixed figure. priceGel stays as the internal
  // estimate so the list can still be ordered and reasoned about.
  priceOnRequest Boolean @default(false)
  order          Int     @default(0)
  // Hidden services keep their row and their history; they simply leave the
  // page. Nothing here is ever deleted — a request may still point at it.
  visible        Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  requests BusinessLead[]

  // The page reads: visible services, grouped by direction, in order.
  @@index([visible, direction, order])
}

// An inbound enquiry from /business. NOT a Company — nobody is a customer until
// an admin says so, and a form anyone can post must never create a billable
// entity. Converting a lead into a Company is a deliberate admin action.
model BusinessLead {
  id          String             @id @default(cuid())
  companyName String
  taxId       String?
  contactName String
  phone       String
  email       String
  // Which direction they are interested in — free text, because the categories
  // on this site are for experts and a company describes its need differently.
  interest    String?
  message     String?
  status      BusinessLeadStatus @default(NEW)
  // Which service they asked for, when they came through a service card rather
  // than the general form at the bottom of the page. Nullable because the
  // general form still exists and because every lead created before 2026-08-11
  // predates the catalogue.
  //
  // SetNull, not Cascade: a retired service must never take the requests it
  // generated with it — those are the record of who asked for what.
  serviceId   String?
  service     B2BService?        @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  // What the owner actually agreed after talking to them, in lari. The price on
  // the card is the advertised one; this is the real one, and the two are
  // deliberately separate — editing the catalogue must not rewrite a deal that
  // was already struck.
  agreedPrice Int?
  // The owner's own notes on the deal: invoice number, what was promised, who
  // it was handed to. Free text because the process it describes lives in a
  // conversation, not in this system.
  adminNote   String?
  createdAt   DateTime           @default(now())

  // The admin queue: unhandled first, newest first.
  @@index([status, createdAt])
  @@index([serviceId])
}

// ═══════════════════════════════════════════════════════════════════════════
// REQUESTS — the client describes a problem, providers bid on it.  2026-08-14
//
// THE DIRECTION IS INVERTED, and that is the entire point. Everywhere else on
// this platform a client picks a person and books their hour: they must already
// know what they need and who does it. Here they say what is wrong and what
// they can spend, an admin phones them to check the request is real, and the
// providers come to them.
//
// ⚠️ IT IS NOT A BOOKING AND SHARES NOTHING WITH ONE. No calendar, no slot, no
// duration, no escrow, no Booking row, no BookingStatus. `Booking`,
// `Consultation`, `Package`, `Enrollment` and `AvailabilitySlot` are untouched
// by this block and must stay that way — a request that quietly grew a startAt
// is the point at which two products become one unmaintainable one.
//
// It is also NOT the B2B block above. `BusinessLead` is a company asking for a
// service WE priced; this is an individual describing a problem NOBODY has
// priced yet, and the price is what the providers compete on.
//
// WHAT STAGE 1 DELIBERATELY OMITS: payment, credits, buying a lead, escrow,
// automatic matching, scoring, ranking, and messaging on a request. The one
// question this stage answers is whether requests arrive at all and whether
// providers answer them.
//
// The whole subsystem is dark behind `FEATURE_REQUESTS` (lib/requests.ts).
// These three tables exist on every deployment and stay EMPTY until somebody
// uses them — the same contract the B2B and packages verticals ship on.
//
// MONEY IS `Int` LARI, matching Company.balance, Booking.price and B2BService
// .priceGel. There is no tetri in this database and this is not the feature
// that should introduce one.
// ═══════════════════════════════════════════════════════════════════════════

// The life of a request, and every state is a thing a HUMAN did.
//
// There is no automatic transition anywhere in this enum — nothing expires,
// nothing is scored, nothing promotes itself. That is a stage-1 decision worth
// naming: a request that changed state on its own would be a request nobody can
// explain on the phone, and the phone is currently the whole verification story.
enum ServiceRequestStatus {
  NEW // it arrived; no admin has looked at it
  VERIFIED // an admin called and confirmed it — providers can see it
  REJECTED // spam, an unreal budget, or nobody could reach them
  MATCHED // the client accepted an offer
  CLOSED // finished, or abandoned
}

// ⚠️ THERE ARE NO `RequestBudget` / `RequestDeadline` ENUMS, and there were,
// for one day (2026-08-14). They were removed the moment the subsystem had to
// cover teaching as well as professional work, and the reason is worth keeping:
//
//   „500–1 000₾" and „20–40₾ ერთ გაკვეთილზე" are both correct answers to „what
//   is your budget", and they are NOT THE SAME QUESTION. One enum holding both
//   is one field answering two — the exact defect the B2BService.kind comment
//   below describes at length, arriving by a different road.
//
// So the money is stored as NUMBERS (`budgetMin`/`budgetMax`) plus the UNIT it
// is measured in, the bands live in lib/requestTopics.ts, and adding a band is
// an edit to an array rather than an ALTER TYPE. Same for the timing: its legal
// values depend on `kind`, which a Postgres enum cannot express at all, so zod
// validating `timing ∈ TIMING[kind]` is a STRONGER guarantee than the enum gave.
//
// `ServiceRequestStatus` below stays an enum on purpose — a lifecycle is closed,
// kind-independent, and is exactly what the database should be guarding.

/// See RequestOffer.kind.
enum RequestOfferKind {
  QUOTE
  BOOKING
}

enum RequestOfferStatus {
  /// ⚠️ THE CLIENT WROTE FIRST, AND THERE IS NO OFFER YET (2026-08-18).
  ///
  /// Until now a client could only wait: a conversation existed once an expert
  /// had answered, and not one second earlier. That is the passive half of this
  /// product and it is the half Profi.ru does not have — there the client picks
  /// somebody from the catalogue and offers them the job („Клиент предлагает
  /// вам заказ"). Owner, 2026-08-18: „ეს გვინდა."
  ///
  /// It is a status on the OFFER row rather than a table of its own, and that
  /// is the whole reason this is cheap: the per-offer thread, the unread counts,
  /// the event journal and the accept path all key on an offer id and none of
  /// them learns a new case. The unique index on (requestId, expertUserId) also
  /// does the right thing for free — a client writing to somebody who has
  /// already bid finds the existing row instead of making a second one.
  ///
  /// ⚠️ AN INVITED ROW IS NOT AN OFFER AND MUST NEVER COUNT AS ONE. It holds no
  /// price (`priceGel` is 0 and means nothing), it does NOT consume a place
  /// against `offerLimit`, it is not listed among the offers the client
  /// compares, and it cannot be accepted — `accept` matches `status: 'SENT'`
  /// and so refuses it by construction. The expert turns it into a real offer
  /// by naming a price, which claims a place at THAT moment.
  INVITED
  SENT
  WITHDRAWN
  ACCEPTED
  DECLINED
}

// An offer comes from a PERSON or from a COMPANY, and the two are different
// kinds of counterparty rather than two shapes of the same one — a company has
// no `User` to notify and a person has no members. Kept as a discriminator so
// `RequestOffer` never has to be read as „whichever of these two ids is set".
enum RequestProviderKind {
  EXPERT
  COMPANY
}

model ServiceRequest {
  id        String @id @default(cuid())
  // THE CODE WE SAY OUT LOUD. „MC-7A4K2" — five characters from an alphabet
  // with no O/0/I/1, so it survives being read down a phone line, which is
  // exactly what the admin does with it. A cuid cannot be dictated.
  //
  // It is also the client's only key to their own request, so it is minted from
  // crypto randomness and NEVER from a sequence: a guessable ref would hand a
  // stranger somebody's phone number. Minted by lib/requests → `makePublicRef`.
  publicRef String @unique

  // WHAT SHAPE THE NEED IS — 'LEARNING' | 'CONSULTATION' | 'PROJECT'.
  //
  // The discriminator the whole row is read through: it decides what `budgetMin`
  // is measured in and what `timing` means. See lib/requestTopics → KIND for why
  // there are exactly three and what the test for a fourth is.
  //
  // A String and not a Postgres enum, deliberately and for the same reason
  // B2BService.kind is: the set is read through lib/requestTopics and validated
  // by zod at both ends, and a taxonomy that is expected to grow is not worth an
  // ALTER TYPE every time it does.
  kind String

  // WHAT THEY NEED — a stable slug from lib/requestTopics ('chemistry',
  // 'contract', 'website'). 132 of them at the time of writing, built to reach
  // hundreds.
  //
  // ⚠️ NOT A `Category` FK, and that is the central decision of this subsystem.
  // The sphere taxonomy describes what the EXPERTS ON THIS PLATFORM DO — 16
  // professional spheres, zero school subjects — so „ქიმია" cannot live there
  // without minting a sphere page with no experts behind it. A REQUEST is the
  // other direction: it says what somebody NEEDS, and people need things the
  // catalogue does not carry yet. Discovering exactly that is the point.
  topic String

  // The sphere whose experts could serve this topic, when one exists —
  // DERIVED from `topic` at write time (lib/requestTopics → categorySlugOfTopic)
  // and stored so the admin panel can list candidate experts beside the request.
  //
  // Null is normal and informative: it means nobody on this platform is filed
  // under what this person asked for.
  //
  // Restrict (the default) rather than SetNull: a sphere with live requests
  // pointing at it must fail loudly on delete rather than silently unfile them.
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  /// 'OFFERS' | 'SELF' — how this person wants to be helped, asked before they
  /// send (2026-08-18).
  ///
  /// ⚠️ IT CONTROLS WHAT THE WAITING SCREEN OFFERS, NOT WHO IS TOLD. Owner:
  /// „თუ [კლიენტმა] აირჩია, რომ ექსპერტებს მე ავარჩევ, მხოლოდ ამ შემთხვევაში
  /// უნდა ჰქონდეს ღილაკი." So SELF adds the expert list and a message button;
  /// it does NOT stop the request reaching experts. Suppressing that would mean
  /// somebody who picked „I'll choose" and then picked nobody hears from
  /// nobody — a silence they did not ask for, produced by a preference about a
  /// button.
  ///
  /// A String and not an enum, like every other small vocabulary in this
  /// subsystem: the set may grow (a „ორივე" is imaginable) and a taxonomy
  /// expected to grow is not worth an ALTER TYPE.
  pickMode String @default("OFFERS")

  // What is wrong, in their words. The 40-character floor is enforced by zod
  // (lib/requests) and not here: a database CHECK cannot tell the person why.
  description String

  // ⚠️ THE MONEY IS NUMBERS, AND THE UNIT CARRIES THE DIFFERENCE. `budgetMax`
  // null is the open top band („120₾-ზე მეტი"). See the block above the enums
  // for why this is not an enum, and lib/requestTopics → BUDGET_BANDS for the
  // bands themselves. Int lari, like every other price in this database.
  budgetMin  Int
  budgetMax  Int?
  // 'PER_LESSON' | 'PER_SESSION' | 'TOTAL'. Determined by `kind` today and
  // stored anyway — snapshotted for the same reason Booking snapshots its
  // serviceType: changing the mapping later must not silently re-price history.
  budgetUnit String

  // The second question, whose MEANING depends on `kind`: a deadline for a
  // project, urgency for a consultation, and FREQUENCY for learning — a weekly
  // lesson has no „by when". One column rather than three mostly-null ones; the
  // legal set per kind is lib/requestTopics → TIMING.
  timing String

  // The clarifying answers — { audience: 'pupil', level: 'beginner', … }.
  //
  // A JSON BAG, DELIBERATELY, because the questions are per kind today and per
  // TOPIC tomorrow (a wedding photographer and a tax auditor need different
  // clarifications), and a thumbtack-shaped catalogue asking each service its
  // own two questions cannot mean a column per question. The vocabulary of
  // legal ids lives in lib/requestTopics → EXTRAS and zod validates against it
  // at the door — so the bag is free-form only in shape, never in content.
  // Same pattern as TutorProfile.professionData.
  //
  // Null means „nothing to clarify for this kind", which is most rows.
  details Json?

  // 'ONLINE' | 'IN_PERSON' | 'EITHER'. Asked before the city because for most
  // of this catalogue „ონლაინ" makes the city irrelevant.
  format String

  // A code („TBILISI"), not the Georgian label. Stored this way so renaming
  // what the form SAYS never rewrites rows — lib/requestTopics → CITIES owns
  // the words. A plain String and not an enum: the list will grow by cities,
  // which is not worth a migration each time.
  city String

  contactName String
  phone       String
  email       String?

  // Set when a signed-in account submitted it. SetNull, deliberately unlike
  // Booking's Restrict: deleting an account must not be refused because of a
  // request, and must not erase the request either — what somebody asked for is
  // a record of the market, and it stays readable with no name on it.
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  /// Photos of the thing that needs doing — base64 data URIs, at most
  /// MAX_REQUEST_PHOTOS (lib/requests). A picture of the leaking tap is what
  /// lets a provider name a real price instead of opening a conversation to
  /// find one out (2026-08-29).
  ///
  /// ⚠️ BLOBS. Never select this into a list payload — the queue, the offers
  /// list and the admin table all read this row. Same rule as
  /// ServiceProfile.workPhotos, and the same reason.
  photos String[]

  status ServiceRequestStatus @default(NEW)

  // The admin's own scratch note — who they spoke to, what was actually wanted.
  // NEVER shown to a client or a provider; only /api/admin/requests selects it.
  adminNote String?

  verifiedAt   DateTime?
  // The admin who verified it. A plain String with no FK, for the same reason
  // AuditLog.actorId and CompanyTransaction.actorId are: this is a record of
  // something that happened, and it must outlive the account that did it.
  verifiedById String?

  // ⚠️ TWO „DONE" FLAGS FOR THE AUTOMATION, and they are columns rather than a
  // derivation on purpose. The cron ticks every 15 minutes, so „has this
  // already been nudged" cannot be inferred from the elapsed window — every
  // tick inside the eligible period would re-send. A written timestamp is the
  // idempotency, and it doubles as the record of WHEN it went.
  //
  // Null = never nudged, which is what every row starts as. See
  // lib/requestRouting for the clock these two are read against.
  /**
   * /**
   * /**
   * /** The unanswered-request re-mail, widened to every provider. Once.
   */
  providerNudgeAt DateTime?
  /**
   * The „you have offers waiting" reminder to the client. Once.
   */
  clientNudgeAt   DateTime?

  // HOW MANY OFFERS THIS REQUEST ACCEPTS. Three by default because that is what
  // a person can actually compare on a phone screen; an admin can raise it for
  // a request worth more attention.
  offerLimit Int @default(3)
  // ⚠️ A COUNTER, NOT A `_count`. It exists to be claimed conditionally:
  // `updateMany({ where: { offerCount: { lt: offerLimit } }, data: { increment } })`
  // + `count !== 1 → 409` is the only way the limit holds against two providers
  // submitting in the same second. Counting the rows first and writing after is
  // the read-then-write CLAUDE.md names, and here it means a fourth offer.
  offerCount Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  offers   RequestOffer[]
  messages RequestMessage[]

  // The admin queue: unhandled first, newest first.
  @@index([status, createdAt])
  // The provider list: verified requests, optionally within a sphere.
  @@index([categoryId, status])
  // „what is being asked for, and how much of it" — the admin's topic filter
  // and the only way to see demand the catalogue does not serve.
  @@index([topic, status])
  // The provider queue filtered to one shape of work.
  @@index([kind, status])
  // ⚠️ THE FK ITSELF (added 2026-08-21). `userId` is ON DELETE SET NULL, and
  // Postgres does NOT index a foreign key for you — so deleting an account had
  // to seq-scan this table to find the rows to null out. app/api/admin/users
  // does exactly that, and tests/userDeletion.test.ts is 524 lines about it.
  @@index([userId])
}

model RequestOffer {
  id        String         @id @default(cuid())
  requestId String
  // Cascade: an offer without its request is unreadable — it names a price for
  // a problem nobody can see. Unlike a ledger row, it records no money moving.
  request   ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  providerKind RequestProviderKind

  expertUserId String?
  expertUser   User?   @relation(fields: [expertUserId], references: [id], onDelete: Cascade)

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // ⚠️ EXACTLY ONE of expertUserId / companyId is set, and Prisma cannot say so
  // — there is no cross-column constraint here and a partial-index CHECK would
  // reject the row without telling the caller which half was wrong. The rule
  // lives in ONE function, `offerProviderError()` in lib/requests.ts, and that
  // function is the only place it is ever checked. Do not re-implement it at a
  // call site: a second copy is how „both set" eventually becomes storable.

  // Lari, whole, like every other price in this database.
  //
  // ⚠️ WHAT THE NUMBER MEANS IS `priceKind`'S JOB, NOT THIS COLUMN'S. On a
  // FIXED offer it is the price; on FROM it is where the price starts; on
  // ON_SITE it is the CALL-OUT FEE and the real price is set at the door. Read
  // without the kind beside it, this integer says three different things.
  priceGel Int

  /// 'FIXED' | 'FROM' | 'ON_SITE' — how to read `priceGel`.
  ///
  /// ⚠️ IT EXISTS BECAUSE A SINGLE INTEGER MADE HONEST TRADESPEOPLE LIE. A
  /// consultant knows the price of an hour; somebody coming to look at a leak
  /// often does not, and a form that demands one number either gets an invented
  /// figure or gets no bid at all. YouDo has carried „по договорённости" beside
  /// a fixed price for exactly this reason.
  ///
  /// ON_SITE is also what decides, later, whether an offer can be BOOKED
  /// straight from a calendar or has to go through the request flow: a price
  /// that only exists after somebody looks at the job cannot be paid for in
  /// advance.
  ///
  /// A String and not an enum, for the reason the rest of this subsystem gives:
  /// the set will grow (a per-hour form is the obvious fourth) and a taxonomy
  /// expected to grow is not worth an ALTER TYPE each time.
  priceKind     String  @default("FIXED")
  // „about ten days". Nullable because some work honestly cannot be estimated
  // before a conversation, and forcing a number there produces a fictional one.
  daysEstimate  Int?
  /// ⚠️ WHAT THE PRICE COVERS — one line, and the one the CLIENT'S LIST SHOWS
  /// (2026-09-01, the owner's design canvas: „რას მოიცავს ფასი", printed under
  /// the price on every offer card in „Request Room v2").
  ///
  /// It exists because `message` could not do this job. A client comparing
  /// three offers cannot read three paragraphs to find out which of them
  /// includes the materials; they can read three one-liners. zod caps it at 120
  /// characters for exactly that reason — it has to survive an ellipsis on a
  /// 350px card.
  ///
  /// ⚠️ NULLABLE, AND THAT IS THE MIGRATION AND NOT A DESIGN CHOICE. Every
  /// offer written before today has none, and a NOT NULL column with a default
  /// would put an invented sentence in somebody's mouth — the client would read
  /// „—" as a claim the provider never made. New offers are required to carry
  /// one by `RequestOfferInput`; old ones render nothing where it would go.
  priceIncludes String?
  // The provider's own note. ⚠️ OPTIONAL SINCE 2026-09-01 — it was required with
  // a 20-character floor, on the argument that a price with no sentence beside
  // it is a guess. `priceIncludes` above is that sentence now, structured, and
  // the canvas placeholders this field „არასავალდებულო" on both artboards.
  // The COLUMN stays NOT NULL: an empty string is what „no note" means here,
  // and 100+ rows already hold real text.
  message       String

  status RequestOfferStatus @default(SENT)

  /// QUOTE = a price for a job (accepting marks the work as agreed; the client
  /// later says „დასრულდა"); BOOKING = an offer that, accepted, creates a
  /// Booking (the consultation path). Stage 7, 2026-08-19.
  kind     RequestOfferKind @default(QUOTE)
  /// Completion of a QUOTE: who pressed „დასრულდა" and when; closedAt = the
  /// silent close after the 14-day reminder. No Job table on purpose (§3.3).
  doneAt   DateTime?
  doneBy   String?
  closedAt DateTime?
  review   Review?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // One offer per provider per request. Not „one per provider": revising a
  // price by sending a second offer would make the offerCount claim above count
  // the same provider twice and eat a competitor's place.
  messages RequestMessage[]
  events   OfferEvent[]

  @@unique([requestId, expertUserId])
  @@unique([requestId, companyId])
  // „my offers, by state" — the /provider/offers page, for both kinds.
  @@index([expertUserId, status])
  @@index([companyId, status])
}

// ONE CONVERSATION PER OFFER — the client and that provider, before anybody
// has anybody's phone number.  2026-08-17
//
// ⚠️ WHY NOT `Message`. That model exists and even carries pre-booking threads
// (`bookingId: null` between a client and an expert) — but BOTH its sides are
// `User` foreign keys, and the client of a request HAS NO ACCOUNT. That is not
// an oversight to route around: „no registration, ever" is the decision the
// whole intake was rebuilt on, and adding a signup step so the client can ask
// „do you teach on Saturdays?" would undo it. So the client side is identified
// by POSSESSION OF THE REQUEST — the same publicRef that already opens their
// page — and only the provider side is a User.
//
// ⚠️ WHY IT OPENS BEFORE THE CHOICE, AND WHY THAT DOES NOT WEAKEN THE SEAL.
// The reference products let a client talk to several providers and then pick;
// research on marketplace disintermediation is blunt about why in-app
// messaging exists at all — it is the channel that keeps the introduction on
// the platform. Without it a client must either choose blind from a price and
// a paragraph, or hand out their number early to ask one question. Chat is
// what makes „the phone opens on acceptance" survivable rather than hostile.
// The seal itself is unchanged: phone and email still appear only on ACCEPTED.
model RequestMessage {
  id String @id @default(cuid())

  // The thread is per OFFER, because the client holds a separate conversation
  // with each provider who answered — merging them into one per request would
  // show every provider what their competitors wrote.
  //
  // ⚠️ NULL IS A THREAD, NOT A MISSING OFFER (2026-08-17). A row with no offer
  // is the client talking to US — the conversation that opens the moment they
  // press send, before any provider has been told the request exists. That gap
  // used to be a thank-you card and a promise to phone; it is now the one place
  // somebody can ask „did it arrive" and get an answer.
  //
  // ONE TABLE RATHER THAN TWO, and the reason is the reader: both threads are
  // the same bubbles, the same receipts, the same unread count, and a second
  // table would have meant a second of each. What genuinely differs — who may
  // read, whether contacts are masked, when it closes — is rules, and rules
  // live in lib/requestChat + lib/requestThread, not in a schema.
  offerId String?
  offer   RequestOffer? @relation(fields: [offerId], references: [id], onDelete: Cascade)

  // Denormalised from the offer so the client's own page can load every thread
  // of their request in one query, and so a message survives being read
  // without a join. Never written independently — see lib/requestChat.
  requestId String
  request   ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  // WHICH SIDE SPOKE. A boolean rather than two nullable FKs: there are
  // exactly two parties to this thread and only one of them is ever a User,
  // so „from the client" is a fact about the row, not an absence.
  fromClient Boolean
  // The provider who wrote it. Null on every client message — that is the
  // shape, not a gap. SetNull rather than Cascade: a company-owned offer
  // outlives the member who typed on it, and the thread is what the company
  // answers for. ⚠️ This is why the table's author CHECK (lib/dbBoot) is
  // ONE-WAY — a CHECK also demanding an author on every provider message would
  // reject the very update SetNull performs, and the purge would fail.
  fromUserId String?
  fromUser   User?   @relation(fields: [fromUserId], references: [id], onDelete: SetNull)

  body String

  // Two read receipts, because there are two readers and neither has an
  // account on both sides. Used for the „N ახალი" badges.
  //
  // ⚠️ „Provider" here means THE OTHER SIDE, whoever that is on this thread —
  // the provider on an offer thread, us on a platform one. The column was not
  // renamed when the platform thread arrived: it is one table with one „the
  // side that is not the client", and a `readByStaffAt` beside it would have
  // been a second column meaning the same thing, which is how two unread counts
  // that disagree get born.
  readByClientAt   DateTime?
  readByProviderAt DateTime?

  createdAt DateTime @default(now())

  // The thread itself: one offer, in order. Rows with no offer are excluded by
  // Postgres from a btree lookup on a NULL, which is why the platform thread
  // reads through the requestId index below instead.
  @@index([offerId, createdAt])
  // The FK Postgres would not index for us — same reason as ServiceRequest.userId
  // above: `fromUserId` is ON DELETE SET NULL and account deletion had to scan.
  @@index([fromUserId])
  // „every thread of my request", for the client's page.
  @@index([requestId, createdAt])
}

// WHO CAN SEE THIS SUBSYSTEM AT ALL — the allowlist, maintained by hand.
//
// ⚠️ AN EXISTING EXPERT GETS NOTHING BY DEFAULT, and that is the whole reason
// this table exists rather than a boolean on TutorProfile or a role check. The
// twenty-odd approved experts on the platform applied to be booked, not to bid
// on leads; switching them all on would ship an unfinished product to people
// who never asked for it. An empty table can only ever produce an empty
// audience, which is the only safe state for a stage-1 test.
//
// `active` rather than a delete: turning somebody off is a decision worth being
// able to see and reverse, and the `note` beside it says why.
/// ⚠️ ENUM VALUES ARE THE SAME FOUR A TUTOR APPLICATION USES — reusing
/// `ApplicationStatus` deliberately, so „SUBMITTED" means the same thing in
/// both admin queues and a reviewer does not have to hold two vocabularies.

/// WHO IS APPLYING — a person with a toolbox, or a firm with vans.
///
/// Owner, 2026-08-17: „რეგისტრაციას უნდა გავითვალისწინოთ ორი რამე — ერთი
/// როგორც ბიზნესი, მეორე როგორც ინდივიდუალური." It is not a cosmetic label:
/// a firm owes us a name and a tax id and is answerable as an entity, while a
/// one-man plumber owes us a face and is answerable as himself. The two
/// therefore collect different fields and, at approval, hang their
/// `ServiceProfile` off different columns — `companyId` or `userId`.
enum ProviderKind {
  INDIVIDUAL
  COMPANY
}

/// A TRADESPERSON ASKING TO BE LISTED — the object that did not exist.
///
/// ⚠️ WHY THIS IS A SEPARATE MODEL AND NOT A FLAG ON TutorApplication.
/// They share a shape and almost nothing else. An expert application is
/// judged on credentials — a diploma, a bar number, a headline, an hourly
/// rate — and grants `role: TUTOR` plus a public `TutorProfile` with
/// consultations and a calendar. A master's is judged on trade, area and
/// whether the face is real, and grants a `RequestAccess` row plus a
/// `ServiceProfile`. Folding them together would mean a `kind` check on every
/// one of the ten approval steps in /api/applications/[id], which is the
/// version of this that gets one branch wrong in silence.
///
/// ⚠️ THIS ROW CARRIES BASE64 IMAGES AND MUST NEVER BE IN A LIST PAYLOAD.
/// `photoUrl` and `workPhotos` are data URIs — the site has no object storage
/// (see /api/uploads), so an image IS the column. The admin list therefore
/// `omit`s them and loads them per opened row, exactly as the tutor queue
/// already does with `idDocUrl`/`certificates`. Forget this and the
/// moderation tab ships twenty megabytes to draw twenty names.
model ProviderApplication {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  kind ProviderKind @default(INDIVIDUAL)

  /// The person we will be speaking to, in both cases — a firm still has
  /// somebody who answers the phone, and „the company" cannot be called.
  fullName String
  phone    String

  /// COMPANY only. Enforced in lib/providerApplication, not by the column: a
  /// draft that switches kind mid-form must not lose what was typed.
  companyName String?
  taxId       String?

  /// Topic ids of `kind: SERVICE` and CityName values — the SAME vocabulary a
  /// request is written in, so approval can copy them into `ServiceProfile`
  /// verbatim and routing stays an equality test. Validated on write.
  services String[]
  areas    String[]

  /// ⚠️ ADDED 2026-08-24, WHEN THIS BECAME THE ONLY APPLICATION. A lawyer and a
  /// plumber now fill in the same form; the lawyer's answer to „ვინ ხარ" is a
  /// profession from lib/professions, and it is what the approved profile's
  /// sphere is derived from. Empty for a trade that names no profession.
  professions String[] @default([])

  /// „12 წელი ვმუშაობ სანტექნიკაზე, ვმუშაობ თბილისში და რუსთავში." Free text,
  /// shown to clients after approval.
  about    String
  yearsExp Int?

  /// Indicative, both nullable — „ask" is an honest answer for a trade where
  /// the price depends on what is behind the wall.
  calloutFee Int?
  priceFrom  Int?
  /// The same `{ topicId: lari }` map — see ServiceProfile.priceList.
  priceList  Json?

  /// The face, or the logo when kind = COMPANY. One image, 512×512 webp data
  /// URI, produced by /api/uploads?kind=avatar.
  photoUrl String?

  /// Photos of finished work. Array of data URIs — capped hard in
  /// lib/providerApplication, because there is no object storage to spill into.
  workPhotos String[]

  status        ApplicationStatus @default(SUBMITTED)
  /// The reviewer's reason. Shown to the applicant on NEEDS_REVISION and
  /// REJECTED — unlike RequestAccess.note, which never is.
  moderatorNote String?
  reviewedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
}

model RequestAccess {
  id String @id @default(cuid())

  kind RequestProviderKind

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  active Boolean @default(true)
  // The admin's reason: „ბესიკი — ტესტისთვის", „აღარ პასუხობს". Never shown to
  // the person it is about.
  note   String?

  createdAt DateTime @default(now())

  // One row per person and one per company. Postgres allows any number of NULLs
  // under a unique constraint, so the two nullable columns do not fight — the
  // same trick Company.taxId relies on.
  @@unique([userId])
  @@unique([companyId])
}

/// WHAT HAPPENED TO AN OFFER — the append-only record the price will be read
/// from.
///
/// ⚠️ THIS EXISTS BECAUSE MONEY IS GOING TO DEPEND ON IT (owner, 2026-08-17:
/// the expert pays „როცა კლიენტმა წაიკითხა"). The moment a billing rule reads
/// „the client opened it", that fact stops being a UI nicety and becomes a
/// financial record — and the one we already had could not carry the weight:
///
///   · `RequestMessage.readByClientAt` is written inside `after()` with a bare
///     `catch {}`, so a failed write loses the event in silence;
///   · it is a MUTABLE column with no history, so „why was I charged" has no
///     evidence behind it;
///   · `updateMany` stamps every unread message at once, so „opened the thread"
///     and „read this offer" are indistinguishable.
///
/// A receipt you cannot show is not a receipt. This table is append-only: rows
/// are inserted, never updated and never deleted, and the billing question is
/// always „what is the FIRST event of this type" rather than „what does the
/// column say now".
///
/// ⚠️ IT RECORDS BOTH `VIEWED` AND `REPLIED`, DELIBERATELY, AND THE PRICE IS 0
/// TODAY. Which of the two should cost money is an open question with real
/// money behind it and no data yet: Profi.ru bills on the open (and refunds if
/// it never happens within five days), Thumbtack bills on the reply — and
/// Thumbtack ABANDONED an open-based refund window, which is evidence the open
/// is the noisier signal. A client who opens five offers out of curiosity and
/// hires nobody has cost five experts money. Recording both while the lead is
/// free costs nothing and buys the decision: after a month the ratio says which
/// signal is worth charging for, and switching is one constant.
model OfferEvent {
  id String @id @default(cuid())

  offerId String
  offer   RequestOffer @relation(fields: [offerId], references: [id], onDelete: Cascade)

  /// 'SENT' | 'DELIVERED' | 'VIEWED' | 'REPLIED' | 'ACCEPTED' | 'DECLINED'.
  /// A String rather than an enum for the reason the rest of this subsystem
  /// gives: the set will grow (a charge type, a refund) and a taxonomy expected
  /// to grow is not worth an ALTER TYPE each time. Validated by lib/offerEvents
  /// at the only place that writes.
  type String

  /// When it happened, from the server clock. Never supplied by a caller — the
  /// browser's clock is not evidence.
  at DateTime @default(now())

  /// Free-form context for the row: which message triggered it, which page. Not
  /// read by any rule — it is what an operator looks at when somebody disputes
  /// a charge, which is the whole reason the table exists.
  meta Json?

  /// ⚠️ THE BILLABLE EVENTS ARE UNIQUE PER OFFER, ENFORCED BY THE DATABASE.
  /// „Opened twice" must cost once, and a uniqueness rule written in TypeScript
  /// is a rule two concurrent requests can both pass. The insert is expected to
  /// violate this and the violation is the answer — see lib/offerEvents.
  @@unique([offerId, type])
  @@index([type, at])
}

/// WHAT A VISITING MASTER DOES, AND WHERE — the supply side of `kind: SERVICE`.
///
/// ⚠️ IT IS A PROFILE, NOT AN ACCESS ROW, and the split is the whole design.
/// `RequestAccess` answers „may you bid at all"; this answers „on what". A
/// plumber is still an ordinary allowlisted person there (`kind: EXPERT` — one
/// named human who writes offers), so nothing about ownership, offers, chat or
/// acceptance learns a new case. Adding a third `RequestProviderKind` would
/// have rippled into every one of those for no gain: the difference between a
/// lawyer and a plumber is not HOW they bid, it is WHAT they are filed under.
///
/// ⚠️ `services` HOLDS TOPIC IDS FROM lib/requestTopics — the SAME vocabulary a
/// request is written in, and that is the point of this table existing.
/// `TutorProfile` files an expert under ONE `categoryId` from the sphere
/// taxonomy, and a request carries a `topic`; the two only meet through
/// `categorySlugOfTopic`, which is null for 65 of 171 topics. Storing the
/// topics themselves means demand and supply finally speak one language, and
/// routing becomes an exact match on a string rather than a translation that
/// mostly fails.
///
/// A String[] and not a join table, for the same reason `TutorProfile
/// .professions` is one: the list is short, always read whole, never queried
/// from the other side, and adding a service must stay an edit to
/// requestTopics.ts with no migration behind it.
model ServiceProfile {
  id String @id @default(cuid())

  /// ⚠️ EXACTLY ONE OF THESE, and the difference is the product's own
  /// (2026-08-18). Owner: „სერვისების ნაწილი დარეგისტრირებული ბიზნესმენები და
  /// ნაწილი ინდივიდუალური." A one-man plumber and a cleaning firm are both
  /// masters, they are told about work the same way and they bid the same way —
  /// what differs is who the client is dealing with, and a client is entitled
  /// to know which.
  ///
  /// Modelled as two nullable columns rather than a `kind` enum plus one id,
  /// matching `RequestOffer` and `RequestAccess`: Postgres allows any number of
  /// NULLs under a unique constraint, so both stay unique without fighting, and
  /// the „exactly one" rule is a CHECK in lib/dbBoot rather than a convention.
  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  companyId String?  @unique
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  /// Topic ids of `kind: SERVICE` — 'plumb-leak', 'clean-flat'. Validated
  /// against the vocabulary on write (lib/serviceProfile), never trusted from a
  /// form: an id that is not a service topic would be a row no request can ever
  /// match, i.e. a provider who silently never hears from us.
  services String[]

  /// Where they will travel. CityName values ('TBILISI', 'BATUMI', …) — the
  /// same set a request's `city` is drawn from, so the two are directly
  /// comparable. Districts are the finer answer this eventually wants; a
  /// request carries no district yet, and a provider picking one we cannot
  /// match against would be a promise the data cannot keep.
  areas String[]

  /// „გამოძახება 30₾" — indicative, shown before anybody bids. Null means „ask",
  /// which is an honest answer and must stay expressible.
  calloutFee Int?
  /// „50₾-დან" — the same, for the work itself.
  priceFrom  Int?
  /// ⚠️ A PRICE PER SERVICE THEY ALREADY PICKED (2026-08-20) — `{ topicId: lari }`.
  ///
  /// The provider's price used to be two numbers for the whole person:
  /// `calloutFee` („გამოძახება 30₾") and `priceFrom` („სამუშაო 50₾-დან"). Those
  /// say what a VISIT costs and nothing about what a JOB costs, so a catalogue
  /// built to sell services could not print „ბინის დალაგება — 60₾" — the one
  /// sentence a client is actually shopping for.
  ///
  /// ⚠️ KEYED BY TOPIC ID, WHICH IS WHY IT IS A MAP AND NOT A TABLE. The names
  /// are not free text: they are the very rows the provider ticked in
  /// `services[]`, so there is nothing extra to type and nothing to keep in
  /// sync. A key that is no longer in `services` is stale by construction and
  /// is ignored on read (lib/serviceProfile → pricedServices); a separate table
  /// would have to re-state the name and could then disagree with the tick.
  ///
  /// Lari, integer, like `priceFrom` beside it. Partial by design: pricing one
  /// service and leaving the rest blank is a normal way to work, and the card
  /// says „ფასს შემოგთავაზებს" for anything unpriced.
  priceList  Json?

  /// THE FACE ON THE CARD — or the logo, when this profile belongs to a company.
  ///
  /// ⚠️ IT IS A BASE64 DATA URI AND IT MUST NEVER BE SELECTED INTO A LIST. The
  /// site has no object storage (see /api/uploads), so the image IS the column:
  /// a 512×512 webp is ~40–200KB, and /services draws up to 60 of these. The
  /// listing therefore selects `hasPhoto` — a computed boolean — and the card
  /// points at /api/masters/[id]/photo, which serves one image with a cache
  /// header. This is the pattern B2BService.imageUrl already uses, and the
  /// reason it exists there is the same reason it exists here.
  photoUrl String?

  /// „12 წელია ვმუშაობ სანტექნიკაზე." Copied from the application at approval
  /// and editable afterwards. Without it a card is a name and a list of tags,
  /// which is what /services was and why it read as a directory of nobody.
  about String?

  /// PHOTOS OF FINISHED WORK.
  ///
  /// ⚠️ THE APPLICATION COLLECTED THESE AND APPROVAL THREW THEM AWAY
  /// (2026-08-18). `ProviderApplication.workPhotos` has held up to six since the
  /// intake shipped — uploaded one at a time, thumbnails, a delete on each —
  /// and there was no column here to copy them into, so the only place they
  /// were ever seen was the admin drawer. Real effort from the applicant,
  /// nothing back.
  ///
  /// ⚠️ AND LIKE `photoUrl`, THESE ARE BASE64 AND MUST NEVER BE SELECTED INTO A
  /// LIST. Six of them is roughly a megabyte per master. The catalogue selects
  /// neither; a profile page, when one exists, will serve them one at a time
  /// through /api/masters/[id]/photo's sibling.
  workPhotos String[]
  /// Public address (stage 5, 2026-08-19): /services/<slug>. Its OWN namespace —
  /// uniqueness is per table, so this never collides with TutorProfile.slug and
  /// the two never share a URL prefix (§3.5 of the restructuring plan).
  slug       String?  @unique
  /// Listed in the catalogue and reachable at /services/<slug>. Approval sets
  /// it; the master (or an admin) can take the page down without losing the row.
  published  Boolean  @default(true)

  /// Off without deleting: a master on holiday stops being routed to and keeps
  /// their list. Separate from `RequestAccess.active`, which is the admin's
  /// switch — this one is the master's own.
  available Boolean @default(true)

  /// WHEN THE PROVIDER LAST SAID „yes, this is what I sell" — null means they
  /// never have.
  ///
  /// ⚠️ IT EXISTS BECAUSE OF THE MIGRATION (2026-08-25). When consultations were
  /// removed, the 27 people who came across were seeded with their whole SPHERE:
  /// a provider with no services is invisible to routing, so „nothing ticked"
  /// would have migrated them into silence. The cost is that all four lawyers
  /// claim all seven legal services — so they read as the same person on a card,
  /// and the filter cannot narrow anything.
  ///
  /// It cannot be fixed FOR them. Their own bios are evidence of what they
  /// definitely do, never of what they do not, so narrowing by text would have
  /// quietly taken „დღგ" away from an accountant who simply had not used the
  /// word — and dropped them out of every queue that names it. Owner, the same
  /// day: „არაფერი არ უნდა შეცვალოს, წაშლა არ გვინდა, მათ უნდა შევიდნენ ისევ
  /// თავიან ექაუნთზე."
  ///
  /// So nothing is changed and nothing is deleted. This column only records
  /// whether the list has been LOOKED AT: /work/services stamps it on save, and
  /// until it is stamped the workspace says so plainly. `null` is the honest
  /// state for everybody who has not been asked yet, including the two profiles
  /// that predate the migration.
  servicesConfirmedAt DateTime?

  /**
   * ═══════════ THE PROFESSIONAL HALF, ABSORBED 2026-08-24 ═══════════════
   * ⚠️ THESE COLUMNS ARE `TutorProfile`'S, MOVED — not new ideas. The
   * consultation product was removed that day and with it the table that held
   * the 27 lawyers, accountants and psychologists on this site. They are
   * providers who sell services, exactly like the two plumbers already here,
   * so they belong in THIS row; what they must not lose on the way is the half
   * of a professional profile a trades profile never needed — the sphere, the
   * professions, the diploma, the years, the languages.
   * The rows carry their OLD ids and their OLD slugs (see the migration), so
   * /experts/<slug> answers the same URL it answered yesterday and every
   * credential still points at the right person.
   */

  /// „12 წელია სამართალში ვმუშაობ" — the one line under the name. Optional: a
  /// plumber's card has never had one and does not need one.
  headline String?

  /// Job labels from lib/professions („ადვოკატი", „ბუღალტერი"). Several,
  /// because one person is several professions inside one sphere — the reason
  /// this was an array on TutorProfile and stays one here.
  professions String[] @default([])

  /// The ONE sphere, derived from the first profession. Drives browse
  /// (/experts?category=), the counts and the SEO landing pages.
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  yearsExp  Int      @default(0)
  languages String[] @default(["ka"])

  /// Checked by an admin. „გადამოწმებული" on the card — never „ვერიფიცირებული".
  verified Boolean @default(false)
  /// The admin's thumb on the catalogue order.
  featured Boolean @default(false)

  linkedinUrl String?
  websiteUrl  String?
  /// A short intro video, YouTube only (lib/youtube).
  videoUrl    String?

  /// What the card promises about replies. `responseHours` is the provider's
  /// own claim; the pair beside it is MEASURED, and only the measured pair is
  /// ever printed as a number (CLAUDE.md rule 6).
  responseHours     Int  @default(24)
  responseMedianMin Int?
  responseSampleN   Int?

  /// Derived from the reviews on this provider's finished jobs. Both stay 0
  /// until somebody rates one — there is nothing to invent here.
  rating       Float @default(0)
  reviewsCount Int   @default(0)

  certificates Certificate[]
  education    Education[]
  experience   Experience[]
  favorites    Favorite[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// The stage-3 routing query is „who lists this topic", so the GIN index goes
  /// on `services` — created in lib/dbBoot, because Prisma cannot express a GIN
  /// index on a scalar list.
  @@index([available])
  @@index([categoryId])
  @@index([featured])
  @@index([published, available])
}

/**
 * ═══════════ WHAT A PROVIDER CAN SHOW FOR THEMSELVES ══════════════════════
 * Three tables that hung on `TutorProfile.id` until 2026-08-24 and now hang on
 * `ServiceProfile.id`. The column was `tutorId`; it is `providerId`, and the
 * migration only had to rename it because the new profile keeps the old id.
 * They stay OPTIONAL and they stay three tables rather than one JSON blob: a
 * diploma is verifiable and a job is not, and `Certificate.verified` is the
 * column an admin actually ticks.
 */
model Certificate {
  id         String   @id @default(cuid())
  providerId String
  title      String
  issuer     String
  year       Int
  /// A scan. Base64 data URI like every other upload here — there is no object
  /// storage, so the file IS the column and is never selected into a list.
  fileUrl    String?
  verified   Boolean  @default(false)
  createdAt  DateTime @default(now())

  provider ServiceProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId])
}

model Education {
  id         String   @id @default(cuid())
  providerId String
  school     String
  degree     String
  field      String?
  startYear  Int
  endYear    Int?
  createdAt  DateTime @default(now())

  provider ServiceProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId])
}

model Experience {
  id          String   @id @default(cuid())
  providerId  String
  company     String
  role        String
  startYear   Int
  endYear     Int?
  description String?
  createdAt   DateTime @default(now())

  provider ServiceProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId])
}

// ─────────────────────────────────────────────────────────────────────────────
// THE THREE TABLES PRISMA DID NOT KNOW ABOUT (declared 2026-08-21)
//
// Event, HelpMessage and JobRun are created by lib/dbBoot and read only through
// `$queryRawUnsafe`, so they were never written down here. That is not merely
// untidy: `prisma db push` reconciles the database TO this file, and a table it
// cannot see is a table it offers to DROP — 2 468 Event rows, every help message
// and the whole sweep history. It prompts first, so it was a trap rather than a
// bug, but `npm run db:push` sits in package.json and the prompt is the only
// thing between it and the data.
//
// Declared from `prisma db pull --print` against production, so these match the
// live columns exactly rather than what someone remembered. The app still reads
// them through raw SQL; nothing needs to change at the call sites. Keep them in
// step with the CREATE TABLE statements in lib/dbBoot — that file is still the
// thing that builds them.

/// Funnel and analytics events. Written by lib/events, read by the admin
/// insights tab. No FK to User on purpose: an event outlives the account.
model Event {
  id     String   @id
  name   String
  at     DateTime @default(now()) @db.Timestamptz(6)
  userId String?
  props  Json?

  @@index([name, at(sort: Desc)])
}

/// „Ask us" messages from the help widget, answered from the admin panel.
model HelpMessage {
  id        String    @id
  at        DateTime  @default(now()) @db.Timestamptz(6)
  route     String?
  question  String?
  message   String
  email     String?
  name      String?
  userId    String?
  status    String    @default("new")
  handledAt DateTime? @db.Timestamptz(6)

  @@index([status, at(sort: Desc)])
}

/// One row per scheduled sweep, keyed by job name — lib/sweepRunner reads it to
/// decide whether a job already ran today.
model JobRun {
  key    String   @id
  ranAt  DateTime @default(now()) @db.Timestamptz(6)
  ok     Boolean?
  result Json?
}

/// ONE ROW PER ATTEMPTED OUTBOUND MESSAGE — mail and SMS both.
///
/// Owner, 2026-09-02: „სად მიდის როდის მიდის და ასეთი დეტალები რომ კარგად იყოს
/// მოწესრიგებული და არ გაგვეპაროს შეცდომები." Before this table the only trace
/// a send left was a console line in the Railway log, which scrolls away — so a
/// letter that never arrived and a letter that was never sent looked identical
/// from the admin, and the difference is the whole of the complaint.
///
/// ⚠️ WRITTEN BY THE SENDERS THEMSELVES (lib/mailer, lib/sms), after the send
/// resolves, never by the caller. A caller that logs its own send is a caller
/// that can forget to, and the two would then disagree about what happened.
///
/// ⚠️ IT HOLDS NO MESSAGE BODY. Most of what goes out is a one-time code or
/// somebody's phone number, and a table an operator can browse is not where
/// either belongs — `key` says WHICH message it was and lib/outbound says what
/// that message contains. `detail` carries the provider's own error text only.
model MessageLog {
  id         String    @id @default(cuid())
  /// 'mail' | 'sms'
  channel    String
  /// An OutboundKey (lib/outbound). Stored as text: a row must outlive a
  /// rename of the key it names, and `outboundLabel` falls back to the raw
  /// string for exactly that case.
  key        String
  /// The address or number as the sender received it. Masked at render for a
  /// phone (lib/sms → mask); an address is shown whole, as it is in the user
  /// table beside it.
  to         String
  /// 'sent' — the provider took it · 'failed' — it did not · 'held' — a rule
  /// here stopped it (cutoff, off switch) · 'logged' — no transport configured.
  status     String
  /// The exact branch that answered: 'gmail', 'resend', 'send', 'log',
  /// 'held-pre-existing', 'sender-http-402'… The status groups; this explains.
  mode       String
  /// The provider's own words when it refused. Truncated at 300.
  detail     String?
  /// The provider's id for the message, when it gave one — the string to quote
  /// at sender.ge or Resend when asking why something did not arrive.
  ref        String?
  /// SMS only: parts billed. Georgian is UCS-2, so this is the cost.
  parts      Int?
  /// SMS only: what the CARRIER said, resolved later from sender.ge's
  /// callback.php — 0 pending · 1 delivered · 2 undelivered.
  ///
  /// ⚠️ `status: 'sent'` IS NOT DELIVERY, and the gap is real rather than
  /// pedantic. sender.ge answering 200 means it accepted the message, exactly
  /// as Twilio's `sent` means „the carrier acknowledged receipt" while
  /// `delivered` waits for a delivery receipt — a message can sit in the gap
  /// for ever with nobody reporting a failure. Null = never asked.
  delivery   Int?
  /// When the delivery report was read, so the poller can skip settled rows.
  deliveryAt DateTime? @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @db.Timestamptz(6)

  @@index([createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@index([key, createdAt(sort: Desc)])
}

/// PER-MESSAGE CONTROL — the admin's half of lib/outbound.
///
/// Owner, 2026-09-02: „მინდა ვმართოთ … სად მიდის როდის მიდის." The registry says
/// what the site CAN send; this table says what it currently DOES, and an admin
/// owns it rather than a deploy.
///
/// ⚠️ A ROW IS AN OVERRIDE, NOT THE TRUTH. Absent = the registry's default, so a
/// message that has never been touched needs no row and a new message arrives
/// switched on without a migration. Same shape as SiteText over siteTextDefs.
///
/// ⚠️ AND A CODE CANNOT BE SWITCHED OFF. lib/outboundSettings refuses to write a
/// row that disables a `credential` message — a password-reset code with an off
/// switch is somebody locked out of their account by a checkbox. Enforced on the
/// server, not by hiding the toggle.
model MessageSetting {
  /// An OutboundKey (lib/outbound).
  key       String   @id
  mailOn    Boolean  @default(true)
  smsOn     Boolean  @default(false)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
}
